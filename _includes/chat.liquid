<style>
  /* chat launcher */
  .launch{position:fixed;right:20px;bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:39;display:inline-flex;align-items:center;gap:10px;padding:10px 16px 10px 10px;border-radius:999px;background:var(--global-text-color);color:var(--global-bg-color);font-size:14px;font-weight:600;box-shadow:0 12px 30px -10px rgba(15,23,42,.45);transition:transform .2s cubic-bezier(.2,.7,.2,1),background .2s}
  .launch:hover{transform:translateY(-2px);background:var(--global-theme-color);color:#fff}
  .launch .av{position:relative;width:28px;height:28px;border-radius:50%;background:color-mix(in srgb,var(--global-theme-color) 12%,transparent);display:inline-flex;align-items:center;justify-content:center;font-size:15px}
  .launch .av::before{content:"💬"}
  .launch .av i{position:absolute;right:-1px;bottom:-1px;width:9px;height:9px;border-radius:50%;background:#22C55E;border:2px solid var(--global-text-color)}
  .launch[hidden]{display:none}
  /* ===== DM chat ===== */
  .dm{position:fixed;right:20px;bottom:calc(20px + env(safe-area-inset-bottom,0px));width:min(400px,calc(100vw - 40px));height:min(620px,calc(100vh - 80px));background:var(--global-card-bg-color);border:1px solid var(--global-divider-color);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.22);z-index:40;display:flex;flex-direction:column;overflow:hidden}
  .dm[hidden]{display:none}
  .dm-top{display:flex;align-items:center;gap:12px;padding:12px 14px;border-bottom:1px solid var(--global-divider-color)}
  .dm-top img{width:40px;height:48px;object-fit:cover;border-radius:6px}
  .dm-top div{flex:1;min-width:0;line-height:1.3}
  .dm-top b{display:block;font-size:15px;font-weight:600}
  .dm-top span{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--global-text-color-light)}
  .dm-top span i{width:7px;height:7px;border-radius:50%;background:#3DDC84}
  .dm-top button{font-size:13px;color:var(--global-text-color-light);padding:6px 8px}
  .dm-top button:hover{color:var(--global-text-color)}
  .dm-log{flex:1;overflow-y:auto;padding:16px 14px;display:flex;flex-direction:column;gap:6px;background:var(--global-code-bg-color)}
  .bub{max-width:82%;padding:9px 13px;font-size:14.5px;line-height:1.6;white-space:pre-wrap;border-radius:16px}
  .bub.me{align-self:flex-end;background:var(--global-theme-color);color:#fff;border-bottom-right-radius:4px}
  .bub.him{align-self:flex-start;background:var(--global-card-bg-color);border:1px solid var(--global-divider-color);border-bottom-left-radius:4px}
  .bub.him a{color:var(--global-theme-color);text-decoration:underline;text-underline-offset:2px;word-break:break-all}
  .bub.him a:hover{opacity:.8}
  .dm-form input:disabled{background:var(--global-code-bg-color);color:var(--global-text-color-light)}
  .bub.him + .bub.him{border-top-left-radius:6px;margin-top:-2px}
  .bub.typing{color:var(--global-text-color-light);letter-spacing:2px}
  .bub.status{color:var(--global-text-color-light);font-size:13.5px;letter-spacing:0;display:flex;align-items:center;gap:8px}
  .spin{width:13px;height:13px;border:2px solid var(--global-divider-color);border-top-color:var(--global-theme-color);border-radius:50%;animation:spin .8s linear infinite;flex:none}
  @keyframes spin{to{transform:rotate(360deg)}}
  @media (prefers-reduced-motion:reduce){.spin{animation:none}}
  .srcs{align-self:flex-start;max-width:82%;display:flex;flex-wrap:wrap;gap:4px 6px;margin:-4px 0 2px 4px;font-size:11.5px;color:var(--global-text-color-light)}
  .srcs a{color:var(--global-text-color-light);text-decoration:none;border:1px solid var(--global-divider-color);border-radius:999px;padding:1px 8px;background:var(--global-bg-color)}
  .srcs a:hover{color:var(--global-theme-color);border-color:var(--global-theme-color)}
  .dm-time{align-self:center;font-size:11.5px;color:var(--global-text-color-light);margin:6px 0}
  .dm-sugg{display:flex;gap:6px;padding:10px 12px 0;overflow-x:auto;scrollbar-width:none;background:var(--global-code-bg-color)}
  .dm-sugg button{flex:none;font-size:12.5px;padding:6px 11px;border:1px solid var(--global-divider-color);border-radius:999px;background:var(--global-card-bg-color);color:var(--global-text-color)}
  .dm-sugg button:hover{border-color:var(--global-theme-color);color:var(--global-theme-color)}
  .dm-sugg[hidden]{display:none}
  .dm-form{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--global-divider-color);background:var(--global-card-bg-color)}
  .dm-form input{flex:1;font:inherit;font-size:14.5px;padding:9px 12px;border:1px solid var(--global-divider-color);border-radius:999px;background:var(--global-bg-color);color:var(--global-text-color)}
  .dm-form input:focus{outline:none;border-color:var(--global-theme-color)}
  .dm-form button{font-size:14px;font-weight:500;padding:9px 14px;border-radius:999px;background:var(--global-theme-color);color:#fff}
  .dm-form button:disabled{opacity:.45;cursor:default}

  /* ===== 포트폴리오 공통 스타일 ===== */
  body{word-break:keep-all;overflow-wrap:anywhere}
  .post-description,.card-text,.pf-intro,.pf-a li,.pf-q li{text-wrap:pretty}
  table td{word-break:keep-all}
  .pf-meta{font-size:.92rem;color:var(--global-text-color-light);line-height:1.7;margin-bottom:.6rem}
  .pf-meta b{color:var(--global-text-color)}
  .pf-kind{display:inline-block;font-size:.75rem;font-weight:600;color:var(--global-theme-color);border:1px solid var(--global-theme-color);border-radius:999px;padding:.05rem .55rem;margin-right:.4rem;vertical-align:1px}
  .pf-sub{color:var(--global-text-color-light);margin-top:-.3rem}
  .pf-links{display:flex;flex-wrap:wrap;gap:.4rem;margin:.6rem 0}
  .pf-links a.btn{border:1px solid var(--global-divider-color);border-radius:6px;padding:.25rem .7rem;font-size:.85rem;color:var(--global-text-color)}
  .pf-links a.btn:hover{border-color:var(--global-theme-color);color:var(--global-theme-color);text-decoration:none}
  .pf-tags span{display:inline-block;font-size:.78rem;color:var(--global-text-color-light);margin-right:.7rem}
  .pf-tags span::before{content:"#";opacity:.5}
  .pf-intro{font-size:1.02rem;line-height:1.85}
  .pf-steps{display:flex;flex-wrap:wrap;gap:.35rem .5rem;padding:0;margin:0 0 1.2rem;list-style:none;counter-reset:s}
  .pf-steps li{counter-increment:s;font-size:.82rem}
  .pf-steps li a{display:inline-block;border:1px solid var(--global-divider-color);border-radius:999px;padding:.15rem .7rem;color:var(--global-text-color)}
  .pf-steps li a::before{content:counter(s) " ";color:var(--global-theme-color);font-weight:700}
  .pf-steps li a:hover{border-color:var(--global-theme-color);text-decoration:none}
  h3 .pf-num{display:inline-flex;align-items:center;justify-content:center;width:1.7rem;height:1.7rem;border-radius:50%;background:var(--global-theme-color);color:#fff;font-size:.9rem;font-weight:700;margin-right:.45rem;vertical-align:3px}
  h3 small{font-size:.75em;color:var(--global-text-color-light);font-weight:400;margin-left:.4rem}
  .pf-q,.pf-a{margin:.8rem 0 1.2rem}
  .pf-q h4,.pf-a h4{font-size:.78rem;letter-spacing:.12em;color:var(--global-text-color-light);margin:0 0 .5rem;display:flex;align-items:center;gap:.6rem}
  .pf-q h4::before,.pf-a h4::before{content:"";width:22px;height:1px;background:currentColor}
  .pf-a h4{color:var(--global-theme-color)}
  .pf-q ul{border-left:2px solid var(--global-divider-color);padding-left:1rem;list-style:none;margin:0}
  .pf-q li{font-size:1.08rem;font-weight:600;line-height:1.7;margin-bottom:.5rem}
  .pf-a ul{list-style:none;padding-left:0;margin:0}
  .pf-a li{position:relative;padding-left:1.1rem;line-height:1.9;margin-bottom:.55rem}
  .pf-a li::before{content:"";position:absolute;left:0;top:.95em;width:8px;height:1px;background:var(--global-theme-color)}
  .pf-a b{background:linear-gradient(transparent 62%,color-mix(in srgb,var(--global-theme-color) 18%,transparent) 62%)}
  .pf-a pre{font-size:.85rem;white-space:pre-wrap}
  table.tbl,table.stats{width:100%;border-collapse:collapse;font-size:.9rem;margin:1rem 0 1.4rem}
  table.tbl th,table.tbl td,table.stats th,table.stats td{text-align:left;padding:.45rem .6rem .45rem 0;border-bottom:1px solid var(--global-divider-color);vertical-align:top}
  table.tbl th,table.stats th{font-size:.75rem;letter-spacing:.06em;color:var(--global-text-color-light);font-weight:600}
  table.stats td.rs{font-size:1.15rem;font-weight:800;white-space:nowrap}
  table.stats td.pv{color:var(--global-text-color-light);white-space:nowrap}
  table.stats td.nt{font-size:.82rem;color:var(--global-text-color-light)}
  .caption{font-size:.8rem;color:var(--global-text-color-light);text-align:center;margin:.4rem 0 1rem}
  .pf-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin:1.2rem 0 1.4rem;padding:1rem 0;border-top:1px solid var(--global-divider-color);border-bottom:1px solid var(--global-divider-color)}
  @media (max-width:600px){.pf-facts{grid-template-columns:repeat(2,1fr);row-gap:.8rem}}
  .pf-facts div{font-size:.8rem;color:var(--global-text-color-light);line-height:1.4;padding-right:.8rem}
  .pf-facts b{display:block;font-size:1.4rem;font-weight:800;color:var(--global-text-color);margin-bottom:.15rem;letter-spacing:-.02em}
  .pf-chatlink{display:inline-flex;align-items:center;gap:.4rem;font-size:.85rem;font-weight:600;border:1px solid var(--global-theme-color);color:var(--global-theme-color)!important;border-radius:999px;padding:.3rem .8rem;text-decoration:none!important}
  .pf-chatlink:hover{background:var(--global-theme-color);color:#fff!important}
  /* 프로필 사진 뒤집기 */
  .profile .pf-flip{position:relative;width:100%;aspect-ratio:1;perspective:1200px;cursor:pointer;margin-bottom:.6rem}
  .profile .pf-flip .in{position:absolute;inset:0;transform-style:preserve-3d;animation:pfflip 9s cubic-bezier(.2,.7,.2,1) infinite}
  .profile .pf-flip:hover .in{animation-play-state:paused}
  .profile .pf-flip img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 20%;border-radius:50%;backface-visibility:hidden;-webkit-backface-visibility:hidden;box-shadow:0 8px 24px -10px rgba(0,0,0,.35)}
  .profile .pf-flip img.b{transform:rotateY(180deg)}
  @keyframes pfflip{0%,44%{transform:rotateY(0)}50%,94%{transform:rotateY(180deg)}100%{transform:rotateY(360deg)}}
  @media (prefers-reduced-motion:reduce){.profile .pf-flip .in{animation:none}}
  /* 타임라인 */
  .pf-timeline{position:relative;padding-left:1.2rem;border-left:2px solid var(--global-divider-color)}
  .pf-year{font-size:1.4rem;font-weight:800;margin:1.6rem 0 .6rem;letter-spacing:-.02em}
  .pf-tl{position:relative;display:grid;grid-template-columns:82px 1fr;gap:.6rem;padding:.7rem 0;border-bottom:1px solid var(--global-divider-color)}
  .pf-tl::before{content:"";position:absolute;left:calc(-1.2rem - 6px);top:1.15rem;width:10px;height:10px;border-radius:50%;background:var(--global-bg-color);border:2px solid var(--global-theme-color)}
  .pf-tl.ms::before{background:var(--global-theme-color)}
  .pf-tl .d{font-size:.82rem;color:var(--global-text-color-light);padding-top:.15rem;font-variant-numeric:tabular-nums}
  .pf-tl .b{font-size:.92rem}
  .pf-tl .k{display:inline-block;font-size:.72rem;color:var(--global-theme-color);border:1px solid var(--global-theme-color);border-radius:999px;padding:0 .5rem;margin-right:.5rem;vertical-align:1px}
  .pf-tl a b{font-size:1rem}
  .pf-tl .s{display:block;font-size:.82rem;color:var(--global-text-color-light);margin-top:.15rem}
  .pf-tl p{margin:.3rem 0 0;color:var(--global-text-color);font-size:.9rem}
  @media (max-width:560px){.pf-tl{grid-template-columns:1fr}}
</style>
<button type="button" class="launch" id="launch" aria-label="고강희와 채팅 열기"><span class="av"><i></i></span>고강희에게 질문하기</button>
<div class="dm" id="dm" hidden role="dialog" aria-label="고강희와 채팅">
  <div class="dm-top">
    <img src="data:image/jpeg;base64," alt="">
    <div><b>고강희</b><span><i></i>지금 답할 수 있어요</span></div>
    <button type="button" id="dm-close" aria-label="닫기">닫기</button>
  </div>
  <div class="dm-log" id="dm-log"></div>
  <div class="dm-sugg" id="dm-sugg">
    <button type="button">안녕하세요</button>
  </div>
  <form class="dm-form" id="dm-form"><input id="dm-in" placeholder="메시지 보내기" autocomplete="off" maxlength="600"><button type="submit" id="dm-send">전송</button></form>
</div>
<script>

/* 소개 페이지 프로필 사진: 두 장이 번갈아 뒤집힌다. 누르면 채팅이 열린다. */
(function(){
  const prof=document.querySelector('.profile'); if(!prof) return;
  const fig=prof.querySelector('figure, picture, img'); if(!fig) return;
  const base='{{ "/assets/img/" | relative_url }}';
  const wrap=document.createElement('div'); wrap.className='pf-flip'; wrap.setAttribute('data-open-chat','1'); wrap.title='채팅으로 질문하기';
  wrap.innerHTML='<div class="in"><img class="a" src="'+base+'avatar.jpg" alt="고강희"><img class="b" src="'+base+'prof_pic.jpg" alt="고강희"></div>';
  fig.replaceWith(wrap);
})();
/* ---------- DM chat with 고강희 (Cloudflare Worker → Gemini) ---------- */
const CHAT_ENDPOINT = "https://goganghee-chat.goganghee.workers.dev";
(function(){
  const dm=document.getElementById('dm'), log=document.getElementById('dm-log'), form=document.getElementById('dm-form'), input=document.getElementById('dm-in'), send=document.getElementById('dm-send'), sugg=document.getElementById('dm-sugg');
  const turns=[]; let busy=false, opened=false, sent=0, strikes=0, locked=false, lastAt=0;
  const SESSION_MAX=30;
  const now=()=>{ const d=new Date(); return `${d.getHours()<12?'오전':'오후'} ${d.getHours()%12||12}:${String(d.getMinutes()).padStart(2,'0')}`; };
  // 모델이 마크다운을 섞어도 깨끗하게: **굵게**, 목록 기호, 헤더 제거, 빈 줄 하나로
  const clean=t=>t.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,'$1($2)').replace(/`([^`]+)`/g,'$1').replace(/\*\*([^*]+)\*\*/g,'$1').replace(/^[\s]*[-*•]\s+/gm,'').replace(/^#+\s*/gm,'').replace(/^(고강희|Ganghee)\s*[:：]\s*/,'').replace(/\n{3,}/g,'\n\n').trim();
  // URL과 이메일을 누를 수 있는 링크로
  const linkify=(el,text)=>{ el.textContent=''; const re=/(https?:\/\/[^\s<>()\]]+[^\s<>()\].,!?;:'"]|(?:github\.com|velog\.io|geulgyeol\.tech|ukta\.inha\.ac\.kr)\/[^\s<>()\]]+[^\s<>()\].,!?;:'"]|[\w.+-]+@[\w-]+\.[\w.]+)/g; let i=0, m;
    while((m=re.exec(text))){ el.appendChild(document.createTextNode(text.slice(i,m.index))); const a=document.createElement('a'); const raw=m[0]; a.href=raw.includes('@')?'mailto:'+raw:(raw.startsWith('http')?raw:'https://'+raw); a.textContent=raw; a.target='_blank'; a.rel='noopener'; el.appendChild(a); i=m.index+raw.length; }
    el.appendChild(document.createTextNode(text.slice(i))); };
  const bub=(cls,text)=>{ const b=document.createElement('div'); b.className='bub '+cls; b.textContent=text; log.appendChild(b); log.scrollTop=log.scrollHeight; return b; };
  const him=(text)=>{ const b=bub('him',''); linkify(b,text); return b; };
  function lock(msg){ locked=true; input.disabled=true; send.disabled=true; input.placeholder=msg; sugg.hidden=true; }
  function open(focus=true){
    dm.hidden=false;
    if(!opened){ opened=true; const t=document.createElement('div'); t.className='dm-time'; t.textContent=now(); log.appendChild(t);
      const hi='안녕하세요! 고강희입니다. 논문이나 프로젝트에서 궁금한 게 있으면 편하게 물어보세요.'; him(hi); turns.push({role:'assistant',content:hi}); }
    if(focus) setTimeout(()=>input.focus(),50);
  }
  document.querySelectorAll('[data-open-chat]').forEach(el=>{ el.style.cursor='pointer'; el.addEventListener('click',e=>{ e.preventDefault(); open(); }); });
  const launch=document.getElementById('launch');
  const openChat=e=>{ if(e) e.preventDefault(); open(); launch.hidden=true; };
  launch.onclick=openChat; 
  new MutationObserver(()=>{ launch.hidden=!dm.hidden; }).observe(dm,{attributes:true,attributeFilter:['hidden']});
  document.getElementById('dm-close').onclick=()=>{ dm.hidden=true; };
  document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&!dm.hidden) dm.hidden=true; });
  async function request(){
    return fetch(CHAT_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages:turns.slice(-12)})});
  }
  async function ask(q){
    q=q.trim(); if(!q||busy||locked) return;
    if(Date.now()-lastAt<1500) return;           // 연타 방지
    lastAt=Date.now(); busy=true; send.disabled=true; input.value=''; sugg.hidden=true;
    bub('me',q); turns.push({role:'user',content:q}); sent++;
    const b=bub('him typing','···');
    try{
      let res=await request();
      if(res.status===502||res.status===503){ await new Promise(r=>setTimeout(r,1500)); res=await request(); }   // 서버 깨우기 재시도
      if(!res.ok){ b.className='bub him'; b.textContent= res.status===429 ? '지금 질문이 많이 몰려 있습니다. 잠시 후에 다시 물어봐 주십시오.' : '지금은 답변이 어렵습니다. 잠시 후 다시 물어봐 주십시오.'; turns.pop(); return; }
      const flag=res.headers.get('X-Flag');
      // 스트림 어디든 제어 줄(\x1e{json}\n)이 섞여 올 수 있다: 도구 단계(검색·파일 읽기), 참고 자료 목록. 나머지가 답변 본문.
      const status=(msg)=>{ b.className='bub him status'; b.textContent=''; const s=document.createElement('span'); s.className='spin'; b.append(s, msg); };
      const reader=res.body.getReader(), dec=new TextDecoder(); let raw='', text='', first=true, sources=[], steps=[];
      const handle=(ev)=>{ if(ev.s==='tool'){ steps.push(ev.label); status(ev.label); } else if(ev.s==='sources'){ sources=ev.items||[]; } };
      while(true){ const {value,done}=await reader.read(); if(done) break; raw+=dec.decode(value,{stream:true});
        // 제어 줄을 걷어내고 본문만 남긴다. 줄이 아직 덜 온 제어 줄은 다음 조각을 기다린다.
        let out='', i=0;
        while(i<raw.length){ const k=raw.indexOf('\x1e',i); if(k<0){ out+=raw.slice(i); i=raw.length; break; }
          out+=raw.slice(i,k); const nl=raw.indexOf('\n',k); if(nl<0){ raw=raw.slice(k); i=-1; break; }
          try{ handle(JSON.parse(raw.slice(k+1,nl))); }catch{} i=nl+1; }
        if(i!==-1) raw='';
        text+=out;
        if(text.trim()){ if(first){ b.className='bub him'; first=false; } b.textContent=clean(text); log.scrollTop=log.scrollHeight; } }
      text=clean(text); b.className='bub him'; linkify(b,text); turns.push({role:'assistant',content:text});
      if(sources.length){ const s=document.createElement('div'); s.className='srcs'; s.append('참고'); for(const it of sources){ const a=document.createElement('a'); a.href=it.u; a.textContent=it.t; a.target='_blank'; a.rel='noopener'; s.appendChild(a); } log.appendChild(s); log.scrollTop=log.scrollHeight; }
      if(flag==='abuse'){ strikes++; if(strikes>=3){ b.textContent='이 대화는 여기까지 하겠습니다.'; lock('대화가 종료되었습니다.'); return; } }
      if(sent>=SESSION_MAX){ him('여기까지 답하겠습니다. 더 궁금하신 점은 khko99@naver.com 로 보내 주시면 직접 답하겠습니다.'); lock('이메일로 문의해 주십시오.'); }
    }catch(e){ b.className='bub him'; b.textContent='연결이 잠시 끊겼습니다. 다시 한번 보내 주십시오.'; turns.pop(); }
    finally{ busy=false; if(!locked){ send.disabled=false; input.focus(); } }
  }
  form.onsubmit=e=>{ e.preventDefault(); ask(input.value); };
  sugg.onclick=e=>{ const t=e.target.closest('button'); if(t) ask(t.textContent); };
})();
</script>
